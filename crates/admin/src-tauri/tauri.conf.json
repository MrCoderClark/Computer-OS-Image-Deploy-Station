{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui-packs/refs/heads/main/tauri/schema.json",
  "productName": "DeployStation",
  "version": "0.1.0",
  "identifier": "com.deploystation.admin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DeployStation — Windows Imaging Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
